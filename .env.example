# ==============================================================================
# SkillSprint AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the required parameters below.
# 3. NEVER commit the actual `.env` file to source control or share it publicly.
# ==============================================================================

# Flask Session & Application Security
# Set a strong random secret key (e.g. generated via `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=enter_a_strong_random_secret_key_here_for_production

# Google Gemini API Key for Pipeline 1 (GenAI Generation)
# Required for live calls to gemini-2.5-flash.
# If omitted or if quota is exhausted, system gracefully falls back to deterministic grounded synthesis.
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime Environment
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000
DATABASE_PATH=skillsprint.db

# Validation Engine Configuration
PASS_THRESHOLD=75.0
MAX_UPLOAD_SIZE_MB=25
MAX_DOC_CHUNKS=200
